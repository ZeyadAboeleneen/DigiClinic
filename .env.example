# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
DATABASE_URL=postgres://postgres@127.0.0.1:54329/marsool
# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me
# Private files (logos, PDFs). Keep outside OneDrive in development.
MEDIA_ROOT=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
LOG_LEVEL=INFO
# Password policy. Production: leave unset (10 chars + similarity/common/numeric checks).
# Local dev: PASSWORD_MIN_LENGTH=6 and STRICT_PASSWORDS=False
PASSWORD_MIN_LENGTH=10
STRICT_PASSWORDS=True
# Local WhatsApp gateway (whatsapp-gateway/server.js reads this file too)
WA_GATEWAY_URL=http://127.0.0.1:3310
WA_GATEWAY_KEY=change-me
