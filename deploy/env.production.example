# Copy to deploy/.env on the server (chmod 600). Never commit it.
# Keep a copy of FIELD_ENCRYPTION_KEY (and BACKUP_KEY) somewhere safe OFF the server: without it, neither the stored
# channel passwords nor any backup can be read. Comments must stay on their own lines (no "VALUE  # comment").

# --- Django ---------------------------------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Optional separate Fernet key for backups (defaults to FIELD_ENCRYPTION_KEY)
BACKUP_KEY=
# The subdomain, plus "web" (the gateway's webhook on the private network) and 127.0.0.1 (container health check)
ALLOWED_HOSTS=clinic.example.com,web,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://clinic.example.com
SITE_URL=https://clinic.example.com
LOG_LEVEL=INFO

# --- database (compose.yml builds DATABASE_URL from it) -------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- web port on 127.0.0.1 — pick one no other project uses (check with: ss -ltnp) ----------
WEB_PORT=8110

# --- WhatsApp gateway shared secret ---------------------------------------------------------
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WA_GATEWAY_KEY=
WA_WEBHOOK_SECRET=

# --- system e-mail (password resets + owner alerts) -----------------------------------------
EMAIL_URL=smtp+tls://user%40example.com:app-password@smtp.gmail.com:587
DEFAULT_FROM_EMAIL=DigiClinic <no-reply@example.com>

# --- backups --------------------------------------------------------------------------------
AUTO_BACKUP=True
